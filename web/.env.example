# 全部留空 → 本機示範模式（PGlite 存在 web/.data/pglite，登入頁可一鍵以示範使用者登入）

# Postgres 連線字串（正式環境用 Neon 的 pooled 連線：主機名稱含 -pooler）。設了就切到 Postgres 模式。
DATABASE_URL=
# 選填：Neon 的 direct 連線（主機名稱不含 -pooler），只給 npm run db:migrate 用
DATABASE_URL_UNPOOLED=

# Better Auth：Postgres 模式必填，至少 32 個字元（openssl rand -base64 32）；本機示範模式可留空
BETTER_AUTH_SECRET=
# 選填：網站網址（例如 https://supplemate.vercel.app）；沒設會從請求推斷
BETTER_AUTH_URL=

# AI（保健品小知識）：mock（預設，固定示範內容、不需要金鑰）或 gemini（Google AI Studio 免費方案）
AI_PROVIDER=mock
# AI_PROVIDER=gemini 時必填；到 https://aistudio.google.com 建立金鑰。只在伺服器使用，不會進 client bundle。
GEMINI_API_KEY=
# 選填：預設 gemini-3.6-flash；備用 gemini-3.5-flash-lite；思考量 low
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING=low
# AI_HOURLY_LIMIT=10                # 每位使用者每小時最多請 AI 整理的次數
# AI_DAILY_LIMIT=100                # 全站每 24 小時上限（0 表示不限）

# 選填
# DATABASE_POOL_MAX=5
# PGLITE_DATA_DIR=.data/pglite      # 本機示範資料的位置；memory:// 表示不存檔
# SM_LOCAL_MODE=1                   # 只有本機用 next start 示範時才需要
